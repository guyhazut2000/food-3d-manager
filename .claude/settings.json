{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",

      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(dir *)",

      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(node *)",

      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",

      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",

      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(docker compose build *)"
    ],

    "ask": [
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",

      "Bash(docker compose down *)",
      "Bash(docker system *)",

      "Bash(npm publish *)",

      "Bash(rm *)",
      "Bash(del *)",
      "Bash(rmdir *)"
    ],

    "deny": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(rm -rf *)",
      "Bash(rm -r -f *)"
    ]
  }
}
